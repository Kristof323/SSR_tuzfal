<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>
    Hello EJS!
    <p>Szabályok száma: <%= szabalyok.length %></p>

    <table>
        <tr>
  <th>Prioritás</th>
  <th>Azonosító</th>
  <th>MAC-cím</th>
  <th>Bekapcsolva</th>
        </tr>
  <% for (const szabaly of szabalyok) { %>
    <tr>
      <td><%= szabaly.priority %></td>
    </tr>
    <tr>
        <td><%= szabaly.id  %></td>
    </tr>     
    <tr>
        <td><%= szabaly.mac %></td>
    </tr> 
    <tr>
       <tr class="<%= szabaly.enabled === 0 ? 'kikapcsolt' : '' %>">
    </tr>

    
  <% } %>
</table>

</body>
</html>